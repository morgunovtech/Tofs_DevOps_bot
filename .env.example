# The only REQUIRED value — everything else is optional or has defaults.
TELEGRAM_BOT_TOKEN=your_token_here
# Recommended: your numeric Telegram user id (@userinfobot shows it). When set,
# only you own the bot — nobody else's /start, a lost database or a restored
# copy can take it over; alerts go to your private chat with the bot.
# Empty: the first /start in a PRIVATE chat with the bot claims it.
TELEGRAM_ADMIN_USER_ID=
# Optional: a group for alerts (negative id, -100…). Needs TELEGRAM_ADMIN_USER_ID.
TELEGRAM_ADMIN_CHAT_ID=
# Optional: seeds the site list on the VERY FIRST run only — after that the
# bot's own UI («🌍 Сайт детально» → ➕/🗑) is the source of truth.
SITES=
# Public HTTPS address of the reverse proxy in front of the bot, e.g.
# https://bot.example.com — see README «Public address on your own server».
# Not needed on Railway: the generated domain is picked up by itself.
PUBLIC_BASE_URL=
CHECK_INTERVAL_MINUTES=5
# Hours between crawls of the sites' links; 0 = не обходить ссылки (no crawl).
LINKS_CHECK_INTERVAL_HOURS=6
MORNING_REPORT_HOUR=9
EVENING_REPORT_HOUR=21
WEEKLY_REPORT_HOUR=11
TIMEZONE=Europe/Moscow
# Port of the web server INSIDE the container. docker-compose.yml publishes
# the same port on 127.0.0.1 only — reach it through a reverse proxy.
WEBHOOK_PORT=8080
# Railway: set 1 — Railway's edge is the only way in.
# Own server: set 1 only behind a reverse proxy (nginx/Caddy/Cloudflare Tunnel)
# AND with the port published on 127.0.0.1 — otherwise anyone who reaches the
# port directly can fake X-Forwarded-For and dodge the rate limit.
TRUST_PROXY=0
# Optional, with TRUST_PROXY=1: networks of the reverse proxy as the bot sees
# it (127.0.0.0/8, 172.16.0.0/12, a CDN's published ranges — comma-separated).
# Set: X-Forwarded-For counts only from these peers, read right-to-left past
# them. Empty: it counts from any peer — its last entry, and only when that
# is an IP address.
TRUSTED_PROXIES=
# Optional: send every call to Telegram through a proxy — for a server where
# api.telegram.org is not reachable directly (a VPS in Russia, for one).
# socks5://user:password@host:1080, socks4://host:1080 or http://host:3128.
# Checks of your sites never go through it.
TELEGRAM_PROXY=

# ── Secrets ──────────────────────────────────────────────────────────────────
# Both are OPTIONAL: an empty or placeholder value is replaced by a random
# secret generated at first start and stored in the DB (see 🩺 Диагностика).
# WEBHOOK_SECRET goes into the JS widget on your sites — every visitor can
# see it, so it is a spam filter, not authentication.
WEBHOOK_SECRET=
# HEARTBEAT_SECRET guards the dead-man switch and MUST differ from the
# webhook secret. Leave empty to have it generated.
HEARTBEAT_SECRET=

# ── Dead-man switch ──────────────────────────────────────────────────────────
# Jobs that must ping the bot regularly, "name:interval_minutes" (comma-sep).
# Ping from cron:  curl -fsS https://YOUR_SERVER/api/heartbeat/<HEARTBEAT_SECRET>/site-backup
# Your own scheduled jobs or other bots — NOT the bot's own database backup,
# which it does by itself every night. Leave empty if you have none: jobs
# can also be added (and removed) right in the chat, «➕ Добавить».
# Example: a nightly site backup and a weekly export:
# HEARTBEAT_JOBS=site-backup:1440,weekly-export:10080
HEARTBEAT_JOBS=

# ── External checks ──────────────────────────────────────────────────────────
# Confirm "site down" from external nodes (check-host.net) before paging.
SECOND_OPINION=1
# Before blaming a site for "no answer at all" the bot checks its own network:
# a TCP connect to each IP below (port 443) and a DNS lookup of each name. Down
# → no alerts, one summary when the network is back. The default list is
# 1.1.1.1,8.8.8.8,9.9.9.9,2606:4700:4700::1111,2001:4860:4860::8888,
# one.one.one.one,dns.google,dns.quad9.net. Behind a firewall that blocks them,
# list hosts it lets through; an empty value switches the check off. A site
# that answers proves the network is up whatever the canaries say.
# NET_CANARIES=
# How many sitemap pages to probe for 5xx per site (hourly).
DEEP_CHECK_SAMPLE=10

# ── Cloudflare Pages actions ─────────────────────────────────────────────────
# Deploy hooks per host (Pages → Settings → Builds → Deploy hooks):
# DEPLOY_HOOKS=example.com=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/XXX
DEPLOY_HOOKS=
# Fire the deploy hook automatically when a site goes down (once per incident).
# On by default when a hook is configured; set 0 to only offer the button.
AUTO_REDEPLOY=1
# For the "purge cache" button: API token with Zone.Cache Purge permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Bot-host monitoring ──────────────────────────────────────────────────────
# Containers on this host to watch & auto-restart. Requires mounting
# /var/run/docker.sock into the bot container (see docker-compose.yml).
# Not the bot's own container (it is skipped). At most 3 restarts in a row:
# then the bot says so and leaves the container to you until it has been
# healthy for half an hour.
AUTORESTART_CONTAINERS=
DISK_ALERT_PCT=85
# Disk auto-cleanup when the disk crosses DISK_ALERT_PCT (needs the docker socket).
# Removes only dangling images (untagged layers no container uses) and build cache
# unused for 24 h — on the whole host, at most once per 12 h, and says what it freed.
# Stopped containers and tagged images are never touched. 1 = on.
AUTO_CLEANUP=0

# ── Where checks may connect ─────────────────────────────────────────────────
# 1: a monitor you type may be an internal address (a NAS, a LAN service) —
# as before; so may its own name when the DNS points it inside (a home router
# answering your domain with the LAN address). 0: only public addresses, even
# typed ones — the strict mode for watching other people's sites. Links,
# nested sitemaps, the redirects of public sites and the screenshot service's
# image never lead into the bot's network either way.
ALLOW_PRIVATE_TARGETS=1

# ── SSL renewal watch ────────────────────────────────────────────────────────
# Warn that auto-renewal hasn't happened when this close to expiry.
SSL_RENEW_WARN_DAYS=10

# ── Notifications ────────────────────────────────────────────────────────────
# Local-time window when non-critical alerts are queued until morning, e.g. 23-8.
QUIET_HOURS=23-8
# Re-alert about unresolved critical incidents every N minutes (0 = off).
ESCALATION_REPEAT_MIN=30
# Default "slow response" threshold in ms (per-site override in the bot).
SLOW_RESPONSE_MS=3000

# ── Public status page ───────────────────────────────────────────────────────
# Serve a public HTML status page (+ /status.json + SVG uptime badges).
# Off by default: the page reveals the list of monitored sites to anyone
# who finds the URL. Can also be toggled from the bot: Настройки → 🌐.
STATUS_PAGE=0
# Optional secret path segment: with a slug the page lives at /status/<slug>
# and bare /status returns 404 — a shareable "private" link.
STATUS_PAGE_SLUG=

# ── Self-maintenance ─────────────────────────────────────────────────────────
# Days of raw per-check history to keep (older rows roll up into daily stats;
# 30/90-day uptime keeps working from the rollups).
RETENTION_DAYS=30
# How many nightly DB backups to keep in data/backups/.
DB_BACKUP_KEEP=7
# External watchdog pinged every 5 min (e.g. https://hc-ping.com/<uuid>).
SELF_HEARTBEAT_URL=
# Weekly OSV vulnerability check of the bot's own packages, plus the hourly
# GitHub deploy watch (services.updates) — one switch for both. The upgrades
# themselves come via Dependabot.
DEPENDENCY_WATCH=1

# ── Page screenshots ─────────────────────────────────────────────────────────
# Rendering service for the "📸 Скрин" button; {url} is substituted.
# Default (microlink.io) is keyless (~50 shots/day) and waits for the render.
# Direct-image alternative: https://image.thum.io/get/width/1024/{url}
SCREENSHOT_TEMPLATE=https://api.microlink.io/?url={url}&screenshot=true&meta=false&waitForTimeout=3500

# ── SEO/GEO monitor ──────────────────────────────────────────────────────────
# Pages per site to inspect in the daily audit (homepage + sitemap sample).
SEO_PAGES_SAMPLE=5
# Below this many no-JS text chars on the homepage the site is considered
# invisible to AI crawlers (they don't execute JavaScript).
SEO_MIN_TEXT_CHARS=400

# ── Index status APIs (реальный статус индексации) ───────────────────────────
# Google Search Console: сервис-аккаунт (Google Cloud → IAM → Service Accounts):
#   1) создай сервис-аккаунт, скачай JSON-ключ;
#   2) включи "Google Search Console API" в проекте;
#   3) в GSC → настройки ресурса → Пользователи → добавь email сервис-аккаунта;
#   4) положи ключ рядом с docker-compose.yml как gsc-key.json и раскомментируй
#      его монтирование в docker-compose.yml.
# Доменный ресурс sc-domain:... покрывает все поддомены.
GSC_SERVICE_ACCOUNT_FILE=/app/gsc-key.json
GSC_PROPERTY=sc-domain:example.com
# Яндекс.Вебмастер: OAuth-токен со скоупом webmaster:read (https://oauth.yandex.ru).
YANDEX_WEBMASTER_TOKEN=

# ── Скорость у реальных посетителей Chrome (Google Chrome UX Report) ─────────
# Пусто — скорость у посетителей не показывается. На сайты ничего ставить не нужно. Ключ
# Google API с включённым «Chrome UX Report API». Проще ввести в боте:
# 🔌 Подключения → ⚡ Скорость у посетителей Chrome.
CRUX_API_KEY=

# ── GitHub: порядок в репозиториях (раздел воскресного отчёта) ────────────────
# Пусто — раздела нет. Fine-grained токен (github.com/settings/personal-access-tokens/new),
# Repository access: All repositories, права Read-only: Metadata, Contents,
# Pull requests, Commit statuses; по желанию Dependabot alerts.
# Можно ввести и в боте: 🩺 Диагностика → 🐙 GitHub.
GITHUB_TOKEN=
# Чьи репозитории смотреть (пользователь или организация). Пусто — владелец токена.
GITHUB_OWNER=

# ── Прочее ───────────────────────────────────────────────────────────────────
# Путь к базе бота (docker-compose уже задаёт /app/data/bot.db).
# DB_PATH=data/bot.db
# Путь к docker socket для автоперезапуска/очистки (менять не нужно,
# если socket смонтирован стандартно; пустое значение = этот путь по умолчанию).
# Отфильтрованный доступ через socket-proxy: docs/SETUP.md, «Свой сервер: доступ к Docker».
# DOCKER_SOCKET=/var/run/docker.sock
# Сокет принадлежит группе root (Docker Desktop, rootless Docker): без этой строки бот
# не получит группу root и функции Docker останутся выключенными — осознанный выбор.
# ALLOW_ROOT_GROUP_SOCKET=1
