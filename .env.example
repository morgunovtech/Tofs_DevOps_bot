TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
SITES=s.morgunov.tech,fprint.morgunov.tech,foundyou.morgunov.tech
CHECK_INTERVAL_MINUTES=5
LINKS_CHECK_INTERVAL_HOURS=6
MORNING_REPORT_HOUR=9
EVENING_REPORT_HOUR=21
TIMEZONE=Europe/Moscow
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change_me_to_random_string
# Optional: your personal Telegram user id for admin checks.
# Required if TELEGRAM_ADMIN_CHAT_ID is a group/channel (negative id).
TELEGRAM_ADMIN_USER_ID=
# Set to 1 only when the webhook server runs behind a reverse proxy
# (nginx/Cloudflare) so rate limiting reads the real IP from X-Forwarded-For.
TRUST_PROXY=0

# ── Dead-man switch ──────────────────────────────────────────────────────────
# Jobs that must ping the bot regularly, "name:interval_minutes" (comma-sep).
# Ping from cron:  curl -fsS https://YOUR_SERVER:8080/api/heartbeat/<HEARTBEAT_SECRET>/backup
# Example: backup must ping daily, certs-sync weekly:
# HEARTBEAT_JOBS=backup:1440,certs-sync:10080
HEARTBEAT_JOBS=
# Defaults to WEBHOOK_SECRET when empty.
HEARTBEAT_SECRET=

# ── External checks ──────────────────────────────────────────────────────────
# Confirm "site down" from external nodes (check-host.net) before paging.
SECOND_OPINION=1
# How many sitemap pages to probe for 5xx per site (hourly).
DEEP_CHECK_SAMPLE=10

# ── Cloudflare Pages actions ─────────────────────────────────────────────────
# Deploy hooks per host (Pages → Settings → Builds → Deploy hooks):
# DEPLOY_HOOKS=s.morgunov.tech=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/XXX
DEPLOY_HOOKS=
# Fire the deploy hook automatically when a site goes down (once per incident).
AUTO_REDEPLOY=0
# For the "purge cache" button: API token with Zone.Cache Purge permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Bot-host monitoring ──────────────────────────────────────────────────────
# Containers on this host to watch & auto-restart. Requires mounting
# /var/run/docker.sock into the bot container (see docker-compose.yml).
AUTORESTART_CONTAINERS=
DISK_ALERT_PCT=85
# Try docker prune automatically when the disk crosses the threshold.
AUTO_CLEANUP=1

# ── SSL renewal watch ────────────────────────────────────────────────────────
# Warn that auto-renewal hasn't happened when this close to expiry.
SSL_RENEW_WARN_DAYS=10

# ── Notifications ────────────────────────────────────────────────────────────
# Local-time window when non-critical alerts are queued until morning, e.g. 23-8.
QUIET_HOURS=23-8
# Re-alert about unresolved critical incidents every N minutes (0 = off).
ESCALATION_REPEAT_MIN=30
# Weekly report: Sunday at this hour (local time).
WEEKLY_REPORT_HOUR=11

# ── Self-maintenance ─────────────────────────────────────────────────────────
# Days of raw per-check history to keep (older rows roll up into daily stats).
RETENTION_DAYS=30
# How many nightly DB backups to keep in data/backups/.
DB_BACKUP_KEEP=7
# External watchdog pinged every 5 min (e.g. https://hc-ping.com/<uuid>).
# If the bot dies, healthchecks.io alerts you instead.
SELF_HEARTBEAT_URL=
